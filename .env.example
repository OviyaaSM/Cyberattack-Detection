# ==========================================
# BACKEND CONFIGURATION
# ==========================================
PORT=8000
HOST=0.0.0.0
# SQLite zero-configuration default for local execution
DATABASE_URL=sqlite:///./cyberattack_detection.db
# PostgreSQL for production (Render / Managed Cloud DB)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*

# Optional AI Investigation Assistant (deterministic fallback if empty)
AI_PROVIDER=deterministic
AI_API_KEY=

# Detection Time Windows (in minutes)
BRUTE_FORCE_WINDOW_MINUTES=10
LATERAL_MOVEMENT_WINDOW_MINUTES=30
DATA_EXFILTRATION_WINDOW_MINUTES=20
PRIVILEGE_ESCALATION_WINDOW_MINUTES=15
MULTI_STAGE_WINDOW_MINUTES=60

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
VITE_API_URL=http://localhost:8000/api
